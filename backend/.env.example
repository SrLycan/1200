# ===== App =====
NODE_ENV=development
PORT=4000
APP_NAME=AutosQuitoCRM
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# ===== Database (PostgreSQL / Supabase) =====
DATABASE_URL=postgresql://autosquito:autosquito_dev_change_me@localhost:5432/autosquito_crm?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_ACCESS_SECRET=replace_with_strong_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_string_min_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Supabase =====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

# ===== WhatsApp Cloud API =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=autosquito_verify_token
WHATSAPP_WEBHOOK_SECRET=

# ===== Instagram Graph API =====
INSTAGRAM_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_VERIFY_TOKEN=autosquito_ig_verify
INSTAGRAM_APP_SECRET=

# ===== Throttling =====
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ===== Logging =====
LOG_LEVEL=info
